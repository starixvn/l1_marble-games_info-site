{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "paths": {
            "@/*": ["./src/*"],
            "@pages/*": ["./src/pages/*"],
            "@layouts/*": ["./src/layouts/*"],
            "@routes/*": ["./src/routes/*"]
        },
        "types": ["vite/client", "node"]
    },
    "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "configs/missing-configuration.js"],
    "exclude": ["node_modules"]
}
